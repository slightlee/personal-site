---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { contactHref } from "../lib/site-metadata";
import { workSlugFromId } from "../lib/work-slug";
import { writingSlugFromId } from "../lib/writing-slug";

const works = (await getCollection("works"))
  .filter((work) => work.data.featured)
  .sort((left, right) => right.data.date.valueOf() - left.data.date.valueOf());

const writings = (await getCollection("writing"))
  .filter((post) => post.data.featured)
  .sort((left, right) => right.data.date.valueOf() - left.data.date.valueOf());
---

<BaseLayout>
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <main class="page-shell" id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">个人网站</p>
        <h1 id="hero-title">{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="lead">{profile.intro}</p>
        <div class="actions" aria-label="主要操作">
          <a class="button primary" href={contactHref(profile.email)}>联系我</a>
          <a class="button secondary" href="#works">查看作品</a>
          <a class="button secondary" href="/writing/">阅读文章</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="个人概要">
        <p class="panel-label">当前状态</p>
        <p>{profile.availability}</p>
        <div class="stats-grid">
          {
            profile.stats.map((item) => (
              <div>
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))
          }
        </div>
      </aside>
    </section>

    <section class="section" aria-labelledby="about-title">
      <div class="section-heading">
        <p class="eyebrow">关于我</p>
        <h2 id="about-title">把想法落成可靠的软件</h2>
      </div>
      <p>
        我长期关注内容型产品、前端架构、自动化交付和测试策略。这个网站本身也是一个小型案例：
        用 Astro 管理静态页面，用 Markdown 维护作品内容，用任务队列和质量门禁约束交付过程。
      </p>
      <div class="highlight-strip" aria-label="个人定位摘要">
        <span>{profile.location}</span>
        <span>内容优先</span>
        <span>工程可信</span>
        <span>持续维护</span>
      </div>
    </section>

    <section class="section" aria-labelledby="principles-title">
      <div class="section-heading">
        <p class="eyebrow">工作方式</p>
        <h2 id="principles-title">我如何推进一个项目</h2>
      </div>
      <div class="principle-grid">
        {
          profile.principles.map((item) => (
            <article class="principle-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="skills-title">
      <div class="section-heading">
        <p class="eyebrow">能力方向</p>
        <h2 id="skills-title">核心能力</h2>
      </div>
      <ul class="tag-list">
        {profile.skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>

    <section class="section" id="works" aria-labelledby="works-title">
      <div class="section-heading">
        <p class="eyebrow">代表作品</p>
        <h2 id="works-title">代表作品</h2>
      </div>
      <div class="works-grid">
        {
          works.map((work) => (
            <article class="work-card">
              <p class="work-meta">
                {work.data.role} · {work.data.date.getFullYear()}
              </p>
              <h3>
                <a href={`/work/${workSlugFromId(work.id)}/`}>{work.data.title}</a>
              </h3>
              <p>{work.data.summary}</p>
              <ul class="tag-list compact" aria-label={`${work.data.title} 技术标签`}>
                {work.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="writing" aria-labelledby="writing-title">
      <div class="section-heading">
        <p class="eyebrow">写作</p>
        <h2 id="writing-title">最新文章与观点</h2>
      </div>
      <div class="writing-list">
        {
          writings.map((post) => (
            <article>
              <p class="work-meta">
                {post.data.date.getFullYear()} · {post.data.tags.join(" / ")}
              </p>
              <h3>
                <a href={`/writing/${writingSlugFromId(post.id)}/`}>
                  {post.data.title}
                </a>
              </h3>
              <p>{post.data.description}</p>
            </article>
          ))
        }
      </div>
      <a class="text-link" href="/writing/">查看全部文章</a>
    </section>

    <section class="section contact" id="contact" aria-labelledby="contact-title">
      <div class="section-heading">
        <p class="eyebrow">联系</p>
        <h2 id="contact-title">保持联系</h2>
      </div>
      <p>欢迎通过邮件或公开链接联系我，讨论产品工程、内容系统和自动化交付。</p>
      <div class="social-links">
        {
          profile.socialLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
